import fckt.effects.Fail
import fckt.effects.Failure.attempt
import fckt.monads.Validation

module Databases {
  @SqlEngine @Fail opening<A>(path: String, body: @Database () -> A): A = when (open(path)) {
    Ok(connection) -> {
      result = attempt {
        Database(
          tryRun = statement -> run(connection, statement),
          tryRunScript = sql -> runScript(connection, sql),
        ) { body() }
      }
      close(connection)
      when (result) {
        Ok(value) -> value
        Error(reason) -> fail(reason)
      }
    }
    Error(why) -> fail("can't open the database $path: $why")
  }

  @Database @Fail query(
    sql: String,
    parameters: List<Value> = [],
  ): List<Row> = ran(Statement(sql, parameters)).rows

  @Database @Fail queryAs<A>(
    columns: Column<A>,
    sql: String,
    parameters: List<Value> = [],
  ): List<A> =
    query(sql, parameters).map { row -> readRow(columns, row, sql) }

  @Database @Fail queryOne<A>(
    columns: Column<A>,
    sql: String,
    parameters: List<Value> = [],
  ): Option<A> =
    query(sql, parameters).firstOrNone().map { row -> readRow(columns, row, sql) }

  @Database @Fail execute(
    sql: String,
    parameters: List<Value> = [],
  ): Int = ran(Statement(sql, parameters)).changes

  @Database @Fail insert(
    sql: String,
    parameters: List<Value> = [],
  ): Int = ran(Statement(sql, parameters)).lastInsertId

  @Database @Fail script(sql: String): Unit = when (tryRunScript(sql)) {
    Ok(_) -> Unit
    Error(e) -> fail(described(e))
  }

  @Database @Fail transaction<A>(body: () -> A): A = {
    script("BEGIN")
    result = attempt { body() }
    when (result) {
      Ok(value) -> {
        script("COMMIT")
        value
      }
      Error(reason) -> {
        script("ROLLBACK")
        fail(reason)
      }
    }
  }

  @Database @Fail private ran(statement: Statement): Executed = when (tryRun(statement)) {
    Ok(executed) -> executed
    Error(e) -> fail(described(e))
  }

  @Fail private readRow<A>(
    columns: Column<A>,
    row: Row,
    sql: String,
  ): A = when (columns.read(row)) {
    Valid(value) -> value
    Invalid(problems) -> fail("${problems.joinToString("; ")}, reading a row of: $sql")
  }

  private described(e: SqlError): String = "${e.message}, in: ${e.sql}"
}
