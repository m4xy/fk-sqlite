import uk.m4xy.fktests.api.Test
import uk.m4xy.sql.*
import uk.m4xy.sql.Columns.*
import uk.m4xy.sql.Databases.*
import fckt.effects.Fail
import fckt.effects.Failure.attempt
import fckt.text.Encodings.*
import fckt.values.Mutable

// Running SQL on a database in memory, and reading what it gives.

type User(id: Int, name: String, email: Option<String>, admin: Boolean)

users: Column<User> = Columns {
  id by int("id")
  name by text("name")
  email by nullable(text("email"))
  admin by boolean("admin")
  User(id, name, email, admin)
}

schema: String = "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT NOT NULL, email TEXT, admin INTEGER NOT NULL DEFAULT 0);"

// Runs body on a new database in memory, with the users table made.
@SqlEngine @Fail withUsers<A>(body: @Database () -> A): A = Databases.opening(":memory:") {
  script(schema)
  body()
}

@Test @SqlEngine @Fail insertingAndQuerying() = withUsers {
  ada = insert("INSERT INTO users (name, email, admin) VALUES (?, ?, ?)", [Text("Ada"), Text("ada@example.com"), Integer(1)])
  bob = insert("INSERT INTO users (name) VALUES (?)", [Text("Bob")])
  assertEquals(1, ada)
  assertEquals(2, bob)
  assertEquals(
    [User(1, "Ada", Some("ada@example.com"), true), User(2, "Bob", None, false)],
    queryAs(users, "SELECT * FROM users ORDER BY id"),
  )
  assertEquals(Some(User(2, "Bob", None, false)), queryOne(users, "SELECT * FROM users WHERE name = ?", [Text("Bob")]))
  assertEquals(None, queryOne(users, "SELECT * FROM users WHERE name = ?", [Text("Cy")]))
}

@Test @SqlEngine @Fail executeSaysHowManyRowsChanged() = withUsers {
  script("INSERT INTO users (name) VALUES ('a'); INSERT INTO users (name) VALUES ('b'); INSERT INTO users (name) VALUES ('c');")
  assertEquals(2, execute("UPDATE users SET admin = 1 WHERE name <> ?", [Text("b")]))
  assertEquals(["a", "c"], queryAs(text("name"), "SELECT name FROM users WHERE admin ORDER BY name"))
}

@Test @SqlEngine @Fail valuesKeepTheirTypes() = Databases.opening(":memory:") {
  bytes = "\u0000ÿ".encodeToBytes()
  rows = query("SELECT ? AS n, ? AS x, ? AS s, ? AS b, ? AS z", [Integer(-7), Real(2.5), Text("€"), Blob(bytes), Null])
  assertEquals([Row(["n", "x", "s", "b", "z"], [Integer(-7), Real(2.5), Text("€"), Blob(bytes), Null])], rows)
}

@Test @SqlEngine @Fail parametersAreNeverSql() = withUsers {
  sneaky = "x'); DROP TABLE users; --"
  insert("INSERT INTO users (name) VALUES (?)", [Text(sneaky)])
  assertEquals([sneaky], queryAs(text("name"), "SELECT name FROM users"))
}

@Test @SqlEngine @Fail aTransactionThatFailsIsUndone() = withUsers {
  outcome: Result<Unit, String> = attempt {
    transaction {
      insert("INSERT INTO users (name) VALUES ('kept?')")
      fail("changed my mind")
    }
  }
  assertEquals(Error("changed my mind"), outcome)
  assertEquals([], queryAs(text("name"), "SELECT name FROM users"))
  transaction { insert("INSERT INTO users (name) VALUES ('kept')") }
  assertEquals(["kept"], queryAs(text("name"), "SELECT name FROM users"))
}

@Test @SqlEngine @Fail whatSqliteCantDoFailsWithWhy() = withUsers {
  assertEquals(Error("no such table: nowhere, in: SELECT * FROM nowhere"), attempt { query("SELECT * FROM nowhere") })
  assertEquals(
    Error("NOT NULL constraint failed: users.name, in: INSERT INTO users (email) VALUES ('e')"),
    attempt { insert("INSERT INTO users (email) VALUES ('e')") },
  )
}

@Test @SqlEngine @Fail aRowThatCantBeReadSaysEveryProblem() = withUsers {
  insert("INSERT INTO users (name, admin) VALUES ('Ada', 7)")
  wrong: Column<(Int, Boolean, String)> = Columns {
    name by int("name")
    admin by boolean("admin")
    missing by text("missing")
    (name, admin, missing)
  }
  assertEquals(
    Error("column name is the text 'Ada', not an integer; column admin is the integer 7, not 0 or 1; there's no column missing, reading a row of: SELECT * FROM users"),
    attempt { queryAs(wrong, "SELECT * FROM users") },
  )
}

@Test @SqlEngine @Fail aDatabaseThatCantBeOpenedSaysWhy() = assertEquals(
  Error("can't open the database /no/such/folder/x.db: unable to open database file"),
  attempt { Databases.opening("/no/such/folder/x.db") { query("SELECT 1") } },
)

// Code that runs SQL is @Database, so a test can give it a database of its own: here, one that
// keeps what it's asked to run, and gives no rows.
@Database @Fail rename(id: Int, name: String): Int = execute("UPDATE users SET name = ? WHERE id = ?", [Text(name), Integer(id)])

@Test @Fail aDatabaseCanBeAnythingThatHandlesIt() = {
  ran: Mutable<List<Statement>> = Mutable([])
  Database(
    tryRun = statement -> {
      ran.value = ran.value + [statement]
      Ok(Executed([], 1, 0))
    },
    tryRunScript = sql -> Ok(Unit),
  ) {
    assertEquals(1, rename(7, "Ada"))
  }
  assertEquals([Statement("UPDATE users SET name = ? WHERE id = ?", [Text("Ada"), Integer(7)])], ran.value)
}
